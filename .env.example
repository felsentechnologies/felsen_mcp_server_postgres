# Postgres MCP Server
#
# Copy this file to .env for local development, then replace the example values.
# Do not commit real credentials or production tokens.

# Optional path to a YAML or JSON config file for local development.
# In Docker/Portainer, leave this unset or use /app/Docker/config.docker.yaml.
# The local example binds to 127.0.0.1 and is not suitable for published
# container ports.
POSTGRES_MCP_CONFIG=configs/example.yaml

# Single-connection fallback used when POSTGRES_MCP_CONFIG is not set.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/postgres?sslmode=disable

# Example named connection used by configs/example.yaml.
CRM_DATABASE_URL=postgres://postgres:postgres@localhost:5432/crm?sslmode=disable

# Bearer token accepted by the MCP server.
# The HTTP client must send: Authorization: Bearer <token>
MCP_API_KEY=change-me-reader-token
MCP_WRITER_API_KEY=change-me-writer-token

# Alias supported by the no-config fallback.
POSTGRES_MCP_API_KEY=change-me-reader-token

# Docker/dev script variables.
HTTP_PORT=8080
MCP_PORT=8080
POSTGRES_MCP_PORT=8080
IMAGE_NAME=mcp-postgres
HTTP_BEARER_TOKEN=change-me-reader-token
MCP_BEARER_TOKEN=change-me-reader-token
MCP_ALLOWED_ORIGINS=

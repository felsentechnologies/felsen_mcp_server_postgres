# Postgres MCP Server
#
# Copy this file to .env for local development, then replace the example values.
# Do not commit real credentials or production tokens.

# Config path used by the Docker/Compose service.
# For host-side go run, set POSTGRES_MCP_CONFIG=configs/example.yaml instead.
POSTGRES_MCP_CONFIG=/app/Docker/config.docker.yaml

# Postgres connection string consumed by the Docker Compose app service.
# For a host-side go run, use localhost instead of postgres and select the local config.
DATABASE_URL=postgres://postgres:replace-with-db-password@postgres:5432/mcp?sslmode=disable

# Postgres container settings
POSTGRES_DB=mcp
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-db-password
POSTGRES_PORT=5432

# Bearer token accepted by the MCP server.
# The HTTP client must send: Authorization: Bearer <token>
MCP_API_KEY=replace-with-a-long-random-reader-token
# Optional role tokens. When set, the config loader creates these principals
# with access to all configured connections:
# MCP_WRITER_API_KEY=replace-with-a-long-random-writer-token
# MCP_DDL_API_KEY=replace-with-a-long-random-ddl-token
# MCP_ADMIN_API_KEY=replace-with-a-long-random-admin-token
# DDL/DML capability flags. They default to enabled; set either to false to
# disable the corresponding mutation capability for every configured connection.
MCP_DDL_ENABLED=true
MCP_DML_ENABLED=true
# Structured table policies are declared in the selected YAML config under
# connections.<name>.dml_policies; these flags enable or disable them globally.
# HMAC key for short-lived browser/OpenAI citation URLs (minimum 32 characters).
MCP_CITATION_SIGNING_KEY=replace-with-a-long-random-citation-key

# OAuth 2.1 for the ChatGPT MCP connector. Leave disabled for API-key-only
# local development. In production use the public HTTPS origin as the issuer
# and resource, and keep the signing key/password outside the config file.
MCP_OAUTH_ENABLED=false
MCP_OAUTH_ISSUER=https://channel-mcp-prospect.felsen.enterprises
MCP_OAUTH_RESOURCE=https://channel-mcp-prospect.felsen.enterprises
MCP_OAUTH_SIGNING_KEY=replace-with-a-different-long-random-oauth-signing-key
MCP_OAUTH_USERNAME=replace-with-oauth-username
MCP_OAUTH_PASSWORD=replace-with-a-long-random-oauth-password
# This is the name of an auth.api_keys entry in the selected YAML config;
# it is not an OAuth scope. The shipped Docker config adds "admin" when
# MCP_ADMIN_API_KEY is configured.
MCP_OAUTH_PRINCIPAL=admin
MCP_OAUTH_CLIENT_ID=felsen-chatgpt
# OAuth scopes requested by ChatGPT. Values are comma- or space-separated.
# default_scopes are used when action-level scopes are not all defined;
# base_scopes are requested on every authorization request.
# Valid scopes: read, write, ddl, admin.
MCP_OAUTH_DEFAULT_SCOPES=read,write,ddl,admin
MCP_OAUTH_BASE_SCOPES=read,write,ddl,admin
#
# Read-only option: use MCP_OAUTH_PRINCIPAL=reader and set both scope values
# to read. Full access still requires MCP_ADMIN_API_KEY above.
# For a custom configuration that declares API keys explicitly, define an
# auth.api_keys principal named "admin", for example:
#   - name: admin
#     token_env: MCP_ADMIN_API_KEY
#     scopes: [read, write, ddl, admin]
#     connections: ["*"]
# Then use these values instead of the read-only values above:
# Exact callback URL shown in ChatGPT's connector settings.
MCP_OAUTH_CALLBACK_URL=https://chatgpt.com/connector/oauth/replace-with-callback-id
# Durable DCR client store backed by the Docker named volume.
MCP_OAUTH_CLIENT_STORE_PATH=/app/data/oauth-clients.json

# Docker/dev script variables.
HTTP_PORT=8080
MCP_PORT=8080
POSTGRES_MCP_PORT=8080
IMAGE_NAME=mcp-postgres
IMAGE_TAG=latest
MCP_PUBLIC_BASE_URL=http://localhost:8080
